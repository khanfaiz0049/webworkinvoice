# ------------------------------------------------------------------------------
# LARAVEL ROOT HTACCESS — Hostinger Compatible
# ------------------------------------------------------------------------------
# Routes all traffic to the public/ subfolder. On Hostinger, this file should
# only exist if your entire Laravel project is deployed into public_html.
#
# For the recommended setup (project OUTSIDE public_html), this file is not
# needed — the public_html/index.php points directly to the project.
# ------------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect empty requests to public/
    RewriteRule ^$ public/ [L]

    # Redirect all other requests to public/ subfolder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable directory browsing
Options -Indexes

# Block access to any hidden files starting with a dot (including .env)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to critical configuration files
<FilesMatch "^(composer\.json|composer\.lock|package\.json|package-lock\.json|artisan|phpunit\.xml|vite\.config\.js|tailwind\.config\.js)$">
    Order allow,deny
    Deny from all
</FilesMatch>
