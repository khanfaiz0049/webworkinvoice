# ------------------------------------------------------------------------------
# SECURE LARAVEL ROOT HTACCESS
# ------------------------------------------------------------------------------
# This file secures your Laravel root directory on production servers.
# It protects sensitive directories from being publicly accessed or scanned,
# prevents directory listing, and routes traffic cleanly to the public folder.
# ------------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect empty requests to public/
    RewriteRule ^$ public/ [L]

    # Redirect all other requests to public/ subfolder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# ------------------------------------------------------------------------------
# SECURITY RULES
# ------------------------------------------------------------------------------

# Disable directory browsing
Options -Indexes

# Block public access to sensitive system directories
RedirectMatch 404 ^/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)

# Block access to any hidden files starting with a dot (including .env)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to critical configuration files
<FilesMatch "^(composer\.json|composer\.lock|package\.json|package-lock\.json|artisan|phpunit\.xml|vite\.config\.js|tailwind\.config\.js)$">
    Order allow,deny
    Deny from all
</FilesMatch>
